# =====================================================
# EduStudent Sight — Environment Variables Template
# Copy this file to .env and fill in your values.
# =====================================================

# 1. AI & LLM PROVIDER KEYS (Optional — enables AI Academic Agent)

# Google Gemini / Gemma 4 API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq Cloud API Key (from https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# DeepSeek API Key (from https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenAI API Key (optional, from https://platform.openai.com/api-keys)
OPENAI_API_KEY=
